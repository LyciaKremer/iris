generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// Auth — email + senha, sem sistema de convite (piloto de uso único/pequena equipe).
// ─────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────
// Candidato — um monitorado (pessoa ou instituição). Substitui o dicionário
// CANDIDATOS de candidatos.py do alertas-wpp. `tipo` decide, em todo o app,
// qual conjunto de prompt/taxonomia/grade de horário usar (ver anthropic.ts,
// sentimento.ts, tema.ts e horarios.ts) — nunca é escolha manual por notícia.
// `ativo=false` é soft-delete: esconde do seletor sem apagar o histórico.
// ─────────────────────────────────────────────────────────────

model Candidato {
  id                   String   @id @default(cuid())
  slug                 String   @unique
  nome                 String
  tipo                 String // "pessoa" | "instituicao"
  clippingMonitoringId String?
  ativo                Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  noticias Noticia[]
}

// ─────────────────────────────────────────────────────────────
// Notícia — substitui os arquivos de cache (manchetes/sentimentos/secretarias)
// e o historico_noticias.json do pipeline Python: cada linha é, ao mesmo
// tempo, o cache (campos nulos = ainda não processado) e o registro
// histórico permanente.
// ─────────────────────────────────────────────────────────────

model Noticia {
  id String @id @default(cuid())

  candidatoId String
  candidato   Candidato @relation(fields: [candidatoId], references: [id])

  // Id do item vindo do vendor de clipping — NÃO é a chave primária: o
  // mesmo noticiaId pode se repetir em dataExecucao diferentes (ver abaixo),
  // então não pode ser único sozinho.
  noticiaId String

  // (noticiaId, dataExecucao) é a chave de dedup do histórico: o mesmo item
  // processado em dois dias diferentes gera duas linhas (replica a regra
  // de historico.py — dedup é por (id, data), não só por id). Escopado por
  // candidato: dois candidatos podem legitimamente ter o mesmo noticiaId
  // vindo do vendor.
  dataExecucao String

  veiculo            String
  tipoVeiculo         String // "Rádio" | "Televisão" | "Online"
  tituloOriginal      String @db.Text
  transcricao         String? @db.Text
  urlMidia            String?
  linkDireto          String?
  sentimentoOriginal  String
  dataPublicacao      DateTime

  // Campos gerados por IA — null = ainda não processado (faz o papel do
  // "cache miss" do pipeline Python).
  resumo          String?  @db.Text
  relevante       Boolean?
  sentimentoFinal String?
  secretaria      String?

  // Trilha de auditoria da verificação/revisão (mesmos campos gravados
  // hoje em historico.py).
  revisadoPelaIa      Boolean  @default(false)
  resumoOriginal      String?  @db.Text
  problemaDetectado   String?  @db.Text
  revisadoManualmente Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([candidatoId, noticiaId, dataExecucao])
  @@index([candidatoId, dataExecucao])
}

// ─────────────────────────────────────────────────────────────
// Localização de veículo — porta de localizacao.py/atualizar_localizacoes.py:
// mapeamento manual (planilha), NÃO inferido por IA, da cidade-sede de cada
// veículo. Global (não por candidato) — a mesma rádio tem a mesma
// cidade-sede pra qualquer candidato monitorado. Usado nos gráficos do
// relatório e na detecção de picos, nunca gravado na própria Noticia (fica
// como lookup dinâmico, então atualizar a planilha corrige o histórico
// inteiro, não só notícias novas).
// ─────────────────────────────────────────────────────────────

model VeiculoLocalizacao {
  veiculo   String   @id
  cidade    String
  regiao    String
  tipoFonte String?
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────
// Checklist diário — acompanhamento manual das ações do dia (envios,
// upload de mídia etc.), marcado no botão flutuante. Uma linha por dia;
// guardado no banco (não localStorage) pra acompanhar de qualquer
// lugar, igual ao resto do app.
// ─────────────────────────────────────────────────────────────

model ChecklistDia {
  data      String   @id // "YYYY-MM-DD"
  itens     Json // { "<chave-do-item>": true|false }
  updatedAt DateTime @updatedAt
}
