# ── Banco de dados ───────────────────────────────────────────
# Connection string POOLED do Neon (host termina em "-pooler"). A aplicação
# fala com o Neon via @neondatabase/serverless, então precisa ser a pooled.
# Neon dashboard → Connection Details → "Pooled connection".
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Opcional: só necessário se `prisma migrate dev` não conseguir criar um
# shadow DB na conexão principal. Use a URL de um segundo banco Neon vazio.
# SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/iris_shadow?sslmode=require"

# ── Autenticação ─────────────────────────────────────────────
# 32+ bytes aleatórios. Gerar com: openssl rand -base64 32
SESSION_SECRET="troque-por-uma-string-aleatoria-longa"

# ── IA ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY="sk-ant-sua-chave-aqui"

# ── Seed (usuário inicial — opcional, tem default) ───────────
# SEED_EMAIL="voce@exemplo.com"
# SEED_PASSWORD="escolha-uma-senha"
